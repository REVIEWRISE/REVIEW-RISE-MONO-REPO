PORT=3005

DATABASE_URL="postgresql://reviewrise_app:app_password@localhost:5432/reviewrise_db?sslmode=prefer"

# Same Google OAuth client used by express-reviews for GBP connections
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Must match express-reviews TOKEN_ENCRYPTION_KEY to read stored tokens
TOKEN_ENCRYPTION_KEY=YOUR_64_CHAR_HEX_KEY

# Public URL Google can fetch for photo uploads (required for reliable uploads).
# Local dev: run `ngrok http 3000` then set to https://YOUR-ID.ngrok-free.app/api/gbp
# Production: https://your-domain.com/api/gbp
GBP_PUBLIC_BASE_URL=
